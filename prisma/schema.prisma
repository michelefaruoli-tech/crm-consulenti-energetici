generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SEGRETERIA
  BACKOFFICE
  AREA_MANAGER
  COLLABORATORE
  COMMERCIALE
}

enum ContractStatus {
  BOZZA
  INSERITO
  DOCUMENTAZIONE_INCOMPLETA
  DOCUMENTAZIONE_COMPLETA
  INVIATO_AL_FORNITORE
  DA_LAVORARE
  /// Inserito ma non ancora contrattualizzato: da visionare e aggiornare appena possibile
  DA_CONTROLLARE
  INVIATO_AL_MASTER
  ERRORE_INVIO
  IN_LAVORAZIONE
  ATTIVATO
  IN_ATTESA_PAGAMENTO
  PAGATO_DAL_FORNITORE
  PROVVIGIONE_LIQUIDATA
  /// Storno gettone applicato (clawback) e conteggiato in Incassato
  STORNATO
  COMPLETATO
  CHIUSO
  ANNULLATO
  /// Pratica Master non andata a buon fine
  KO
}

enum CommissionPaymentType {
  MENSILE
  UNA_TANTUM
  RATEIZZATO
  BONUS
  PREMIO
}

enum ClientType {
  PRIVATO
  AZIENDA
}

/// Ricorrenza canonica e indicizzabile (deriva da Contract.recurrence testuale).
/// UT = gettone una tantum · M = ricorrente mensile · R = ricorrente annuale (12 mesi)
enum ContractRecurrenceKind {
  UT
  M
  R
}

enum AgendaItemType {
  APPOINTMENT
  TASK
}

enum AgendaPriority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(COLLABORATORE)
  active    Boolean  @default(true)
  passwordChangedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientsCreated   Client[]                @relation("ClientCreatedBy")
  contracts        Contract[]              @relation("ContractCollaborator")
  contractsCreated Contract[]              @relation("ContractCreatedBy")
  statusChanges    ContractStatusHistory[]
  auditLogs        AuditLog[]
  commissionPayouts CommissionEntry[]      @relation("CommissionPaidBy")
  emailLogsSent    ContractEmailLog[]      @relation("EmailSentBy")
  passwordResetTokens PasswordResetToken[]
  securityEvents   UserSecurityEvent[]
  /// Fornitori che questo utente può vedere/lavorare (Backoffice / Area Manager / collab limitati)
  supplierScopes   UserSupplierScope[]
  /// Collaboratori “coperti” (Backoffice) o team gestito (Area Manager)
  collaboratorScopes UserCollaboratorScope[] @relation("BackofficeUser")
  /// Dove questo utente compare nello scope di un backoffice / area manager
  scopedByBackoffices UserCollaboratorScope[] @relation("ScopedCollaborator")
  agendaItems          AgendaItem[]
  /// Import provvigioni e ciclo di liquidazione
  importTemplatesCreated ImportTemplate[]   @relation("ImportTemplateCreatedBy")
  payoutRunsCreated      PayoutRun[]        @relation("PayoutRunCreatedBy")
  payoutBatchesUploaded  PayoutBatch[]      @relation("PayoutBatchUploadedBy")
  payoutRows             PayoutRow[]        @relation("PayoutRowCollaborator")
  payoutAdjustments      PayoutAdjustment[] @relation("PayoutAdjustmentCollaborator")
  payoutAdjustmentsCreated PayoutAdjustment[] @relation("PayoutAdjustmentCreatedBy")
  payoutReportRunsCreated  PayoutReportRun[]  @relation("PayoutReportRunCreatedBy")
  payoutReportItems        PayoutReportItem[] @relation("PayoutReportItemCollaborator")
}

model Client {
  id          String     @id @default(cuid())
  type        ClientType @default(PRIVATO)
  companyName String?
  firstName   String?
  lastName    String?
  fiscalCode  String?
  vatNumber   String?
  email       String?
  pec         String?
  phone       String?
  iban        String?
  address     String?
  street      String?
  streetNumber String?
  city        String?
  province    String?
  region      String?
  zipCode     String?
  country     String?    @default("Italia")
  /// Residente / Non residente / Altri usi
  classification String?
  /// Business: rappresentante legale
  legalFirstName String?
  legalLastName  String?
  legalFiscalCode String?
  sdiCode        String?
  supplyAddress  String?
  supplyStreet   String?
  supplyStreetNumber String?
  supplyCity     String?
  supplyProvince String?
  supplyRegion   String?
  supplyZipCode  String?
  addressesMatch Boolean?
  notes       String?
  deletedAt   DateTime?
  createdById String
  createdBy   User       @relation("ClientCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  contracts Contract[]
  documents Document[]
  history   ClientHistory[]
  agendaItems AgendaItem[]

  @@index([fiscalCode])
  @@index([vatNumber])
  @@index([lastName, firstName])
  @@index([email])
  @@index([deletedAt])
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  active    Boolean  @default(true)
  email     String?
  notes     String?
  /// Mesi di storno dal ingresso in fornitura (es. 12). Null = non configurato.
  stornoMonths Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services        Service[]
  commissionRules CommissionRule[]
  contracts       Contract[]
  userScopes      UserSupplierScope[]
  payoutSources   PayoutSource[]
}

/// Scope fornitori per utente (Backoffice Enel vede solo Enel, ecc.)
model UserSupplierScope {
  userId     String
  supplierId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@id([userId, supplierId])
  @@index([supplierId])
}

/// Scope collaboratori opzionale: se presenti, il backoffice vede solo quei collab
model UserCollaboratorScope {
  userId         String
  collaboratorId String
  user           User @relation("BackofficeUser", fields: [userId], references: [id], onDelete: Cascade)
  collaborator   User @relation("ScopedCollaborator", fields: [collaboratorId], references: [id], onDelete: Cascade)

  @@id([userId, collaboratorId])
  @@index([collaboratorId])
}

model Service {
  id         String   @id @default(cuid())
  name       String
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  contracts       Contract[]
  commissionRules CommissionRule[]
}

model CommissionRule {
  id           String                @id @default(cuid())
  supplierId   String
  supplier     Supplier              @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  serviceId    String?
  service      Service?              @relation(fields: [serviceId], references: [id])
  name         String
  paymentType  CommissionPaymentType @default(UNA_TANTUM)
  /// Totale una tantum (base+RID+web+mail+UT iniziale). Calcolato in salvataggio.
  fixedAmount  Decimal?              @db.Decimal(10, 2)
  percentage   Decimal?              @db.Decimal(5, 2)
  installments Int?
  /// PRIVATO | BUSINESS | TUTTI
  clientSegment String?
  /// Mesi storno specifici di questa regola (override del fornitore)
  stornoMonths Int?
  gettoneBase              Decimal? @db.Decimal(10, 2)
  gettoneRid               Decimal? @db.Decimal(10, 2)
  /// Extra se bolletta web
  gettoneBollettaWeb       Decimal? @db.Decimal(10, 2)
  /// Extra se fattura via email
  gettoneMail              Decimal? @db.Decimal(10, 2)
  /// Gettone ricorrente mensile
  gettoneMensile           Decimal? @db.Decimal(10, 2)
  /// Una tantum iniziale (insieme al mensile)
  gettoneUnaTantumIniziale Decimal? @db.Decimal(10, 2)
  notes        String?
  validFrom    DateTime              @default(now())
  validTo      DateTime?
  active       Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  contracts Contract[]
}

model Contract {
  id               String         @id @default(cuid())
  /// ID originale dal foglio Excel / sistema precedente
  externalId       String?        @unique
  contractNumber   String         @unique
  clientId         String
  client           Client         @relation(fields: [clientId], references: [id])
  collaboratorId   String
  collaborator     User           @relation("ContractCollaborator", fields: [collaboratorId], references: [id])
  createdById      String?
  createdBy        User?          @relation("ContractCreatedBy", fields: [createdById], references: [id])
  supplierId       String
  supplier         Supplier       @relation(fields: [supplierId], references: [id])
  serviceId        String?
  service          Service?       @relation(fields: [serviceId], references: [id])
  commissionRuleId String?
  commissionRule   CommissionRule? @relation(fields: [commissionRuleId], references: [id])
  status           ContractStatus @default(BOZZA)

  /// Luce / Gas / Telefonia / POS / Fotovoltaico...
  utilityType      String?
  productName      String?
  offerCode        String?
  contractKind     String?
  /// POD o PDR (legacy singolo)
  podPdr           String?
  pod              String?
  pdr              String?
  /// Fisso / Variabile / Indicizzato
  priceType        String?
  pcv              Decimal?       @db.Decimal(10, 4)
  pricePerKwh      Decimal?       @db.Decimal(10, 6)
  pricePerSmc      Decimal?       @db.Decimal(10, 6)
  spread           Decimal?       @db.Decimal(10, 6)
  monthlyFee       Decimal?       @db.Decimal(10, 2)
  oneOffFee        Decimal?       @db.Decimal(10, 2)
  discount         Decimal?       @db.Decimal(10, 2)
  powerKw          Decimal?       @db.Decimal(10, 2)
  annualKwh        Decimal?       @db.Decimal(12, 2)
  annualSmc        Decimal?       @db.Decimal(12, 2)
  bandCount        Int?
  bandsJson        String?
  economicNotes    String?
  /// Una tantum / Mensile... (testo storico, resta fonte di verità per la UI)
  recurrence       String?
  /// Versione canonica e indicizzata di `recurrence`: usare SEMPRE questa nei filtri.
  /// Mantenuta in sync dalle scritture tramite `recurrenceWriteData()`.
  recurrenceKind   ContractRecurrenceKind @default(UT)
  paymentMethod    String?
  /// IBAN specifico del contratto (copia indipendente dall'anagrafica)
  contractIban     String?
  ibanHolder       String?
  ibanHolderCf     String?
  sepaMandate      String?
  paymentNotes     String?
  /// Indirizzo di fornitura (copia storica, non dipende dall'anagrafica cliente)
  supplyStreet         String?
  supplyStreetNumber   String?
  supplyCity           String?
  supplyProvince       String?
  supplyRegion         String?
  supplyZipCode        String?
  supplyCountry        String?  @default("Italia")
  supplyAddress        String?
  addressesMatch       Boolean?
  /// Bassa tensione / Media tensione (business luce)
  voltageLevel         String?
  invoiceEmail     String?
  invoiceMode      String?
  billingPeriod    String?
  operationType    String?
  operationOther   String?
  serviceOther     String?
  agency           String?
  rowType          String?
  parentExternalId String?
  parentContractId String?
  monthlyPeriod    String?
  supplyClassification String?
  durationMonths   Int            @default(12)
  sendToMaster     Boolean        @default(false)
  assignedToMaster Boolean        @default(false)
  sentToMasterAt   DateTime?
  masterEmail      String?
  emailStatus      String?
  emailMessageId   String?
  emailAttempts    Int            @default(0)
  emailLastError   String?
  emailLastAttemptAt DateTime?
  emailIdempotencyKey String?
  koReason         String?
  koNotes          String?
  workCompletedAt  DateTime?
  expectedPaymentAmount Decimal?  @db.Decimal(10, 2)
  expectedPaymentDate DateTime?
  paymentAmount    Decimal?       @db.Decimal(10, 2)
  masterNotes      String?
  internalNotes    String?
  workNotes        String?
  /// JSON condizioni/servizi tecnici extra
  technicalJson    String?
  economicJson     String?
  paymentJson      String?

  insertionDate    DateTime       @default(now())
  subscriptionDate DateTime?
  receivedDate     DateTime?
  /// Data inizio fornitura
  supplyStartDate  DateTime?
  activationDate   DateTime?
  paymentDate      DateTime?
  collectionDate   DateTime?
  expiryDate       DateTime?
  stornoEndDate    DateTime?
  workEmailDate    DateTime?

  paymentStatus    String?
  workStatus       String?
  toWork           Boolean        @default(false)
  manuallyVerified Boolean        @default(false)
  isHistorical     Boolean        @default(false)
  archiveLabel     String?
  commissionConfirmed Boolean     @default(false)
  commissionConfirmedAt DateTime?
  attachmentsJson  String?
  notes            String?
  deletedAt        DateTime?

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  statusHistory ContractStatusHistory[]
  documents     Document[]
  commission    Commission?
  recurringMonths RecurringMonth[]
  emailLogs     ContractEmailLog[]
  payoutRows       PayoutRow[]
  payoutAdjustments PayoutAdjustment[]

  @@index([status])
  @@index([collaboratorId])
  @@index([supplierId])
  @@index([recurrenceKind])
  /// Percorso caldo liste (Provvigioni/Contratti): base filtro + categoria UT/M/R
  @@index([deletedAt, isHistorical, recurrenceKind])
  @@index([collaboratorId, deletedAt, isHistorical])
  @@index([podPdr])
  @@index([pod])
  @@index([pdr])
  @@index([insertionDate])
  @@index([expiryDate])
  @@index([commissionConfirmed])
  @@index([isHistorical])
  @@index([archiveLabel])
  @@index([deletedAt])
  @@index([sendToMaster])
  @@index([assignedToMaster])
  @@index([sentToMasterAt])
}

model ContractStatusHistory {
  id          String          @id @default(cuid())
  contractId  String
  contract    Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  fromStatus  ContractStatus?
  toStatus    ContractStatus
  changedById String
  changedBy   User            @relation(fields: [changedById], references: [id])
  changedAt   DateTime        @default(now())
  note        String?
  changeReason String?
  koReason     String?
  expectedPaymentAmount Decimal? @db.Decimal(10, 2)
  expectedPaymentDate   DateTime?
  activationDate        DateTime?
  paymentDate           DateTime?
  paymentAmount         Decimal? @db.Decimal(10, 2)
}

model Commission {
  id         String   @id @default(cuid())
  contractId String   @unique
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  expected   Decimal  @default(0) @db.Decimal(10, 2)
  accrued    Decimal  @default(0) @db.Decimal(10, 2)
  received   Decimal  @default(0) @db.Decimal(10, 2)
  paid       Decimal  @default(0) @db.Decimal(10, 2)
  /// Data in cui il gettone è stato stornato (clawback)
  stornoDate   DateTime?
  /// Importo gettone da stornare (di norma = gettone incassato)
  stornoAmount Decimal? @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  entries CommissionEntry[]
}

/// Tracciamento mensile per contratti ricorrenti (es. Helios)
model RecurringMonth {
  id         String   @id @default(cuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /// Mese di competenza YYYY-MM (es. 2026-04 = gettone di aprile)
  period     String
  /// PAID | PENDING | MISSING | CLOSED | ERROR_UNPAID
  status     String   @default("PENDING")
  amount     Decimal? @db.Decimal(10, 2)
  /// Quando è stato segnato come pagato (data reale click/incasso)
  paidAt     DateTime?
  /// Mese del rendiconto / bonifico YYYY-MM (es. pagato a luglio → 2026-07, competenza aprile)
  settledPeriod String?
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([contractId, period])
  @@index([status])
  @@index([period])
  @@index([settledPeriod])
  @@index([contractId])
  /// Espansione righe per stato rata (Incassato / Da incassare / Pagato)
  @@index([status, period])
  @@index([contractId, status])
}

model CommissionEntry {
  id           String     @id @default(cuid())
  commissionId String
  commission   Commission @relation(fields: [commissionId], references: [id], onDelete: Cascade)
  type         String
  amount       Decimal    @db.Decimal(10, 2)
  note         String?
  paidById     String?
  paidBy       User?      @relation("CommissionPaidBy", fields: [paidById], references: [id])
  createdAt    DateTime   @default(now())
}

model Document {
  id         String    @id @default(cuid())
  clientId   String?
  client     Client?   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: Cascade)
  filename   String
  mimeType   String
  size       Int
  /// Percorso logico: db://… (contenuto in contentBase64). Non usare FS Vercel.
  path       String
  /// Tipologia documento (CI_FRONTE, BOLLETTA, ...)
  docType    String?
  /// Contenuto base64 in PostgreSQL (Neon). Null se eliminato dopo invio / retention.
  contentBase64 String?
  /// postgres_base64 | cleared
  storageProvider String? @default("postgres_base64")
  uploadedById String?
  uploadedAt DateTime  @default(now())
  /// Soft-clear contenuto dopo email / retention (metadati restano)
  contentClearedAt DateTime?
  contentClearedReason String?
  deletedAt DateTime?
}

model ContractEmailLog {
  id           String   @id @default(cuid())
  contractId   String
  contract     Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  toEmail      String
  subject      String
  status       String
  /// MASTER_NEW | MASTER_RESEND | DAILY_REPORT | STALE_LAVORAZIONE_48H | AGENT_STATUS_NOTES | OTHER
  emailType    String   @default("MASTER_NEW")
  error        String?
  attempts     Int      @default(1)
  messageId    String?
  sentById     String?
  sentBy       User?    @relation("EmailSentBy", fields: [sentById], references: [id])
  /// Idempotency / payload hash
  payloadHash  String?
  sentAt       DateTime?
  createdAt    DateTime @default(now())

  @@index([contractId])
  @@index([payloadHash])
  @@index([status])
  @@index([emailType])
}

model DailyContractReport {
  id             String   @id @default(cuid())
  /// YYYY-MM-DD Europe/Rome
  reportDate     String
  recipient      String
  contractsCount Int      @default(0)
  status         String
  messageId      String?
  attempts       Int      @default(1)
  lastError      String?
  payloadSummary String?
  sentAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([reportDate, recipient])
  @@index([reportDate])
  @@index([status])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Hash del token (mai token in chiaro)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model UserSecurityEvent {
  id        String   @id @default(cuid())
  /// Null se login fallito con email sconosciuta / honeypot
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// LOGIN | LOGIN_FAILED | LOGIN_BLOCKED | HONEYPOT | PASSWORD_CHANGED | PASSWORD_RESET_REQUESTED | PASSWORD_RESET_COMPLETED
  eventType String
  /// Email tentata (anche se utente non trovato)
  email     String?
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([eventType])
  @@index([ipAddress, createdAt])
  @@index([createdAt])
}

model ClientHistory {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  field     String
  oldValue  String?
  newValue  String?
  changedBy String
  changedAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
}

model ContractNumberSequence {
  /// Anno (es. 2026)
  year Int @id
  last Int @default(0)
}

model CreateIdempotency {
  key         String   @id
  contractIds String
  userId      String?
  createdAt   DateTime @default(now())
}

model BackupLog {
  id        String   @id @default(cuid())
  filename  String
  size      Int?
  status    String
  createdAt DateTime @default(now())
}

model AgendaItem {
  id          String         @id @default(cuid())
  title       String
  notes       String?
  type        AgendaItemType @default(TASK)
  priority    AgendaPriority @default(MEDIUM)
  scheduledAt DateTime?
  allDay      Boolean        @default(false)
  completed   Boolean        @default(false)
  alertAt     DateTime?
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId    String?
  client      Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId, scheduledAt])
  @@index([userId, completed])
  @@index([alertAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Import provvigioni da fonti eterogenee e ciclo di liquidazione.
// Il formato dei file vive qui (ImportTemplate), non nel codice: nuova fonte =
// nuova mappatura da interfaccia, senza deploy.
// ─────────────────────────────────────────────────────────────────────────────

/// Tipo di fonte da cui arriva il rendiconto
enum PayoutSourceKind {
  /// Rendiconto diretto di un fornitore
  SUPPLIER_STATEMENT
  /// Documento di pagamento / invito a fatturare di un master o agenzia
  MASTER_STATEMENT
  /// Comparatore o marketplace: più fornitori nello stesso file
  MARKETPLACE
  OTHER
}

enum PayoutFileKind {
  XLSX
  CSV
}

/// Stato del ciclo di liquidazione
enum PayoutRunStatus {
  /// Aperto: accoglie file, rettifiche e rigenerazioni
  DRAFT
  /// Almeno un file applicato ai contratti
  APPLIED
  /// Applicazione annullata
  REVERTED
  /// Chiuso: nessuna ulteriore modifica attesa
  CLOSED
}

enum PayoutBatchStatus {
  PARSED
  APPLIED
  PARTIALLY_APPLIED
  REVERTED
  FAILED
}

enum PayoutRowMatch {
  /// Contratto trovato, non ancora applicato
  MATCHED
  /// Più candidati o punteggio sotto soglia: mai applicata in automatico
  AMBIGUOUS
  /// Nessun contratto: possibile contratto mai inserito a sistema
  UNMATCHED
  /// Esclusa dall'utente
  IGNORED
  APPLIED
  ERROR
}

/// Incassato dal fornitore ≠ liquidato al collaboratore: due eventi distinti
enum PayoutMarkMode {
  INCASSATO
  LIQUIDATO
}

enum PayoutAdjustmentKind {
  /// Voce aggiuntiva a favore del collaboratore
  EXTRA
  /// Storno a carico del collaboratore (importo negativo)
  STORNO
  /// Acconto già versato, da sottrarre dal netto (importo negativo)
  ACCONTO
  /// Correzione di un importo importato
  RETTIFICA
}

enum PayoutReportStatus {
  PENDING
  GENERATING
  READY
  PARTIAL
  FAILED
}

enum PayoutReportDelivery {
  PENDING
  /// Invio avviato: se resta qui, va verificato a mano (nessuna transazione)
  SENDING
  SENT
  ERROR
  SKIPPED
}

/// Fonte logica dei rendiconti (fornitore, master, comparatore)
model PayoutSource {
  id         String           @id @default(cuid())
  name       String
  kind       PayoutSourceKind @default(SUPPLIER_STATEMENT)
  /// Null per le fonti che mescolano più fornitori nello stesso file
  supplierId String?
  supplier   Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  active     Boolean          @default(true)
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  templates ImportTemplate[]
  batches   PayoutBatch[]

  @@unique([name])
  @@index([active])
}

/// Mappatura colonne riusabile e versionata: il cuore della generalizzazione
model ImportTemplate {
  id       String         @id @default(cuid())
  sourceId String
  source   PayoutSource   @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  name     String
  fileKind PayoutFileKind @default(XLSX)
  /// Chiave del preset di codice da cui deriva (es. vendite_dirette): permette di
  /// partire dalle mappature note senza costruirle da zero
  builtinKey String?
  /// Scelta dei fogli: { mode: exact|regex|all, value, skip: [] }
  sheetMatchJson String?
  /// 0 = rilevamento automatico nelle prime righe
  headerRow      Int     @default(1)
  /// Mappa campo → lettera colonna o intestazione: { "pod": "Cod.Ute.", "amount": "L" }
  columnMapJson  String
  /// Separatore decimale, inversione di segno per foglio, colonne da sommare
  numberFormatJson String?
  /// it | it_dash | us | excel | month_abbr | yyyymm
  dateFormat     String?
  /// Regole di esclusione riga: stop al primo totale, colonne obbligatorie, …
  skipRowRulesJson String?
  version     Int      @default(1)
  active      Boolean  @default(true)
  createdById String?
  createdBy   User?    @relation("ImportTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  batches PayoutBatch[]

  @@index([sourceId, active])
}

/// Ciclo di liquidazione: traccia persistente, riapribile e modificabile
model PayoutRun {
  id String @id @default(cuid())
  /// Mese di rendiconto YYYY-MM, allineato a RecurringMonth.settledPeriod
  period      String
  label       String
  status      PayoutRunStatus @default(DRAFT)
  markMode    PayoutMarkMode  @default(INCASSATO)
  notes       String?
  createdById String
  createdBy   User            @relation("PayoutRunCreatedBy", fields: [createdById], references: [id])
  appliedById String?
  appliedAt   DateTime?
  /// Marcatura «liquidato al collaboratore», passo successivo e distinto
  liquidatedAt DateTime?
  closedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  batches     PayoutBatch[]
  adjustments PayoutAdjustment[]
  reportRuns  PayoutReportRun[]

  @@unique([period, label])
  @@index([status])
  @@index([period])
}

/// Un file di rendiconto importato dentro un ciclo
model PayoutBatch {
  id         String          @id @default(cuid())
  runId      String
  run        PayoutRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  sourceId   String
  source     PayoutSource    @relation(fields: [sourceId], references: [id])
  templateId String?
  template   ImportTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  filename   String
  /// SHA256 del contenuto: impedisce di importare due volte lo stesso file
  sha256     String            @unique
  fileSize   Int
  status     PayoutBatchStatus @default(PARSED)
  totalRows     Int @default(0)
  matchedRows   Int @default(0)
  ambiguousRows Int @default(0)
  unmatchedRows Int @default(0)
  appliedRows   Int @default(0)
  /// Somma degli importi delle righe lette
  computedTotal Decimal? @db.Decimal(12, 2)
  /// Totale dichiarato dal file (riga/foglio di riepilogo): serve alla quadratura
  declaredTotal Decimal? @db.Decimal(12, 2)
  error        String?
  uploadedById String
  uploadedBy   User      @relation("PayoutBatchUploadedBy", fields: [uploadedById], references: [id])
  appliedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  rows PayoutRow[]

  @@index([runId])
  @@index([status])
}

/// Riga del file con esito del matching e stato precedente per l'annullamento
model PayoutRow {
  id        String      @id @default(cuid())
  batchId   String
  batch     PayoutBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  sheetName String      @default("")
  rowIndex  Int
  /// Riga originale come letta: audit e revisione senza riaprire il file
  rawJson   String

  podRaw          String?
  /// POD/PDR normalizzato usato per il match
  podKey          String?
  clientNameRaw   String?
  fiscalCodeRaw   String?
  /// Fornitore indicato nel file (le fonti marketplace ne mescolano diversi)
  supplierHint    String?
  /// Collaboratore indicato nel file: indizio, non verità
  collaboratorHint String?
  amount          Decimal? @db.Decimal(12, 2)
  /// Mese di competenza dedotto YYYY-MM
  period          String?

  matchStatus PayoutRowMatch @default(UNMATCHED)
  matchScore  Int?
  /// pod_exact | pdr_zero_fill | fiscal_code | pod_masked_suffix | name_period
  matchReason String?
  contractId  String?
  contract    Contract?      @relation(fields: [contractId], references: [id], onDelete: SetNull)
  /// Collaboratore derivato dal contratto trovato, non dal file
  collaboratorId String?
  collaborator   User?       @relation("PayoutRowCollaborator", fields: [collaboratorId], references: [id], onDelete: SetNull)
  /// Rata effettivamente aggiornata
  recurringMonthId String?
  /// Stato precedente di contratto, rata e provvigione: rende annullabile l'applicazione
  previousStateJson String?
  /// Candidati in caso di ambiguità, per la scelta manuale
  candidateIdsJson  String?
  appliedAt    DateTime?
  resolvedById String?
  resolvedAt   DateTime?
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([batchId, sheetName, rowIndex])
  @@index([batchId, matchStatus])
  @@index([podKey])
  @@index([collaboratorId])
  @@index([contractId])
}

/// Rettifica manuale: distinta dai dati importati, non li sovrascrive
model PayoutAdjustment {
  id             String               @id @default(cuid())
  runId          String
  run            PayoutRun            @relation(fields: [runId], references: [id], onDelete: Cascade)
  collaboratorId String
  collaborator   User                 @relation("PayoutAdjustmentCollaborator", fields: [collaboratorId], references: [id])
  kind           PayoutAdjustmentKind
  /// Importo con segno: positivo somma, negativo sottrae.
  /// ACCONTO e STORNO sono sempre negativi (l'acconto è già stato versato).
  amount         Decimal              @db.Decimal(12, 2)
  /// Motivo della rettifica: obbligatorio per non ripetere gli script correttivi
  note           String
  contractId     String?
  contract       Contract?            @relation(fields: [contractId], references: [id], onDelete: SetNull)
  createdById    String
  createdBy      User                 @relation("PayoutAdjustmentCreatedBy", fields: [createdById], references: [id])
  updatedById    String?
  /// Annullamento non distruttivo: la voce resta visibile con il suo motivo
  voidedAt       DateTime?
  voidedById     String?
  voidReason     String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([runId, collaboratorId])
  @@index([runId, voidedAt])
}

/// Esecuzione di generazione report, versionata a ogni rigenerazione
model PayoutReportRun {
  id      String    @id @default(cuid())
  runId   String
  run     PayoutRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// 1, 2, 3… si incrementa a ogni rigenerazione
  version Int
  status  PayoutReportStatus @default(PENDING)
  /// Motivo della rigenerazione
  reason      String?
  createdById String
  createdBy   User      @relation("PayoutReportRunCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items PayoutReportItem[]

  @@unique([runId, version])
  @@index([status])
}

/// Report di un collaboratore in una versione: snapshot dei totali + stato invio
model PayoutReportItem {
  id             String          @id @default(cuid())
  reportRunId    String
  reportRun      PayoutReportRun @relation(fields: [reportRunId], references: [id], onDelete: Cascade)
  collaboratorId String
  collaborator   User            @relation("PayoutReportItemCollaborator", fields: [collaboratorId], references: [id])
  /// Totali congelati: il documento si rigenera identico anche dopo nuove rettifiche
  importedTotal    Decimal @db.Decimal(12, 2) @default(0)
  adjustmentsTotal Decimal @db.Decimal(12, 2) @default(0)
  netTotal         Decimal @db.Decimal(12, 2) @default(0)
  rowCount         Int     @default(0)
  /// Righe e rettifiche congelate: sostituisce il salvataggio del file
  snapshotJson     String
  delivery  PayoutReportDelivery @default(PENDING)
  toEmail   String?
  attempts  Int       @default(0)
  lastError String?
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([reportRunId, collaboratorId])
  @@index([delivery])
}
