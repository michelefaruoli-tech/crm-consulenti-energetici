# CRM Consulenti Energetici — variabili d'ambiente
#
# Copia questo file in `.env` (sviluppo) o imposta le variabili su Vercel.
# NON inserire qui valori reali: questo file è versionato.

# ─── Database (obbligatorio) ────────────────────────────────────────────────
# PostgreSQL su Neon. L'adapter HTTP non supporta le transazioni.
DATABASE_URL=

# ─── Autenticazione (obbligatorio) ──────────────────────────────────────────
# Segreto per firmare il JWT di sessione (cookie crm_session). Stringa lunga e casuale.
AUTH_SECRET=
# Lunghezza minima della password, default 8
PASSWORD_MIN_LENGTH=

# ─── Email SMTP ─────────────────────────────────────────────────────────────
# Senza queste variabili le notifiche e i report non vengono inviati:
# l'applicazione continua a funzionare e segnala l'invio come non effettuato.
SMTP_HOST=
SMTP_PORT=
# true | false — impostato automaticamente a true sulla porta 465
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Alias storico di SMTP_PASS, usato se SMTP_PASS non è impostata
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
# Alias storico di SMTP_FROM_EMAIL
SMTP_FROM=

# ─── Destinatari ────────────────────────────────────────────────────────────
# Email dell'Admin: notifiche contratti, pratiche da lavorare, destinatario
# predefinito dei report
MASTER_EMAIL=
# Destinatario dei report di liquidazione provvigioni. I report arrivano
# all'utente, non ai collaboratori, così può inoltrarli lui.
# Se vuota si usa MASTER_EMAIL.
PAYOUT_REPORT_TO=
# Destinatario dei backup automatici. Se vuota si usa MASTER_EMAIL.
BACKUP_EMAIL=

# ─── Cron (Vercel) ──────────────────────────────────────────────────────────
# Segreto richiesto dagli endpoint /api/cron/*, come header
# `Authorization: Bearer <valore>`
CRON_SECRET=

# ─── Applicazione ───────────────────────────────────────────────────────────
# URL pubblico, usato nei link delle email
NEXT_PUBLIC_APP_URL=
# Ragione sociale mostrata nell'informativa privacy
PRIVACY_COMPANY_NAME=

# ─── OCR e AI (facoltativo) ─────────────────────────────────────────────────
# Catena di fallback per l'auto-compilazione da documento. Senza chiavi la
# funzione resta disabilitata; il resto del CRM funziona.
# Ordine dei provider, separati da virgola (es. groq,gemini,openrouter,openai)
OCR_PROVIDERS=
GROQ_API_KEY=
GROQ_OCR_MODEL=
GROQ_TEXT_MODEL=
GEMINI_API_KEY=
GEMINI_OCR_MODEL=
# Alias di GEMINI_API_KEY
GOOGLE_AI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_OCR_MODEL=
OPENROUTER_OCR_FALLBACK_MODEL=
OPENROUTER_TEXT_MODEL=
OPENROUTER_PDF_ENGINE=
OPENROUTER_APP_NAME=
OPENROUTER_SITE_URL=
OPENAI_API_KEY=
OCR_MODEL=
# OCR.space: la chiave demo pubblica non va usata in produzione
OCRSPACE_API_KEY=
# Limiti di caricamento documenti
MAX_DOCUMENT_SIZE_MB=
MAX_DOCUMENTS_PER_ANALYSIS=

# ─── Diagnostica (facoltativo) ──────────────────────────────────────────────
# Hash del commit mostrato in pagina; su Vercel si usa VERCEL_GIT_COMMIT_SHA
GIT_HASH=
